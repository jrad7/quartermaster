{
  "name": "myproject",
  "tracker": {
    "type": "jira",
    "url": "https://acme.atlassian.net",
    "project": "PROJ",
    "auth": "basic",
    "email_env": "JIRA_EMAIL",
    "token_env": "JIRA_API_TOKEN"
  },
  "owner": "me",
  "workspace": ".",
  "plan_dir": "planning/issues",
  "label_prefix": "claude-",
  "command_prefix": "/",
  "commands": {
    "plan": "/qm-plan {key}",
    "revise": "/qm-plan {key} revise",
    "fix": "/qm-plan {key} fix",
    "work": "/qm-work {key}"
  },
  "transitions": {
    "in-progress": "In Progress"
  },
  "interval": 120,
  "parallel": true,
  "auto_plan": true,
  "max_resumes": 3,
  "run": {
    "env": {},
    "plan_env": {},
    "path_prepend": [],
    "note": "",
    "plan_note": ""
  },
  "dashboard": {
    "port": 8770,
    "service": "quartermaster@myproject"
  }
}
