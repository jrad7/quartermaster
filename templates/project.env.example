# ~/.config/quartermaster/<name>.env  (chmod 600) — read by the systemd units.
QM_CONFIG=/home/YOUR_USER/src/myproject/quartermaster.json
# Jira Cloud: the account email and an API token (id.atlassian.com → Security → API tokens).
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Jira Server / Data Center: a personal access token, with "auth": "bearer" in the config.
# GitHub: gh's own login, or a token for a machine account:
# GH_TOKEN=
